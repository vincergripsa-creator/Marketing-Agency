# Copy to .env and fill in. .env is gitignored (this repo is public).

# Optional. Without a key the agency runs in "heuristic" mode (offline, free, deterministic).
# With a key, agents think and write with Claude (real tokens = real cost on your Anthropic account).
ANTHROPIC_API_KEY=

# auto = Claude if a key is present, otherwise heuristic | heuristic | claude
MIND_MODE=auto

# Hard cap on real Claude spend per simulation run, in EUR. Above it the agency falls back to heuristic mode.
MAX_COMPUTE_EUR=3

# Model per tier (defaults shown)
MODEL_OPUS=claude-opus-5-5
MODEL_SONNET=claude-sonnet-5-5
MODEL_HAIKU=claude-haiku-5-5

# HTTP port of the agency server (the web UI talks to it)
PORT=4317
